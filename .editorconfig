# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,toml,yaml,yml}]
indent_size = 2

[*.md]
indent_size = 2
max_line_length = 100
# Markdown hard line breaks use trailing spaces intentionally.
trim_trailing_whitespace = false

[*.rs]
indent_size = 4
max_line_length = 100

[*.{sh,bash}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
