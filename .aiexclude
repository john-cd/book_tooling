# Exclude generated artifacts, local machine state, and secrets from AI edits.

# Build outputs and caches
/target/
**/target/
/build/
**/build/
/debug/
.dprint-cache/
.sccache/
/bin/

# Git metadata and local worktree state
.git/
.worktrees/

# Editor and operating system state
.idea/
.history/
.ionide/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Transient output
*.log
*.tmp
*.bak

# Local credentials and environment configuration
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
# Generated artifacts, caches, and local machine state
**/debug/
/.sccache/
**/.sccache/
**/*.rs.bk

# Repository metadata and worktree state
/.worktrees/
**/.worktrees/

# Editor and operating-system state
.vscode/

# CI runner output
/.ci/
**/.ci/

# Local credentials and environment files
