# Exclude generated artifacts, local machine state, and secrets from AI edits.

# Build outputs and caches
/target/
**/target/
/build/
**/build/
/debug/
.dprint-cache/
.sccache/
/bin/

# Git metadata and local worktree state
.git/
.worktrees/

# Editor and operating system state
.idea/
.history/
.ionide/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Transient output
*.log
*.tmp
*.bak

# Local credentials and environment configuration
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem

# Local outputs, caches, and linked worktrees
/.sccache
/.worktrees/
**/__pycache__/
**/.venv/
**/.ruff_cache/
**/.pytest_cache/
